{
  "name": "speechsplitter-backend",
  "version": "1.0.0",
  "description": "The speechsplitter backend: local analysis service, CLI and TUI powered by the langchunk engine",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf apps/*/dist packages/*/dist",
    "speechsplitter": "node apps/cli/dist/cli.js",
    "server": "node apps/server/dist/server.js",
    "tui": "node apps/tui/dist/tui.js",
    "setup:stanza": "python3 -m venv --system-site-packages .venv-stanza && .venv-stanza/bin/python -m pip install -r packages/tier1-stanza/python/requirements.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "langchunk": "^0.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "nlp",
    "text-segmentation",
    "multilingual",
    "universal-dependencies",
    "language-learning"
  ],
  "author": "Khizar",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khizardevelops/speechsplitter.git"
  },
  "homepage": "https://khizardevelops.github.io/speechsplitter/",
  "bugs": {
    "url": "https://github.com/khizardevelops/speechsplitter/issues"
  }
}
