{
  "name": "langchunk-app",
  "version": "1.0.0",
  "description": "The LangChunk application: web app, local analysis service, CLI and TUI over the langchunk engine",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf apps/*/dist packages/*/dist",
    "langchunk": "node apps/cli/dist/cli.js",
    "server": "node apps/server/dist/server.js",
    "tui": "node apps/tui/dist/tui.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "langchunk": "^0.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "nlp",
    "text-segmentation",
    "multilingual",
    "universal-dependencies",
    "language-learning"
  ],
  "author": "Khizar",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khizardevelops/langchunk-app.git"
  },
  "homepage": "https://khizardevelops.github.io/langchunk-app/",
  "bugs": {
    "url": "https://github.com/khizardevelops/langchunk-app/issues"
  }
}
